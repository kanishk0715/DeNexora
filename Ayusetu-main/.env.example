# ============================================
# Academia-Industry Collaboration Portal
# Shared Environment Variables Configuration
# ============================================

# ============================================
# BACKEND SERVICE (Node.js + Express)
# Port: 5000
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/academia-industry-portal?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email Service (Nodemailer/SendGrid)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Academia-Industry Portal <noreply@portal.com>

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# AI SERVICE (Python + FastAPI)
# Port: 8000
# ============================================

# AI Service Configuration
AI_SERVICE_PORT=8000
BACKEND_URL=http://localhost:5000

# MongoDB for AI Service (same as backend)
AI_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/academia-industry-portal?retryWrites=true&w=majority

# SpaCy Model
SPACY_MODEL=en_core_web_sm

# ============================================
# FRONTEND SERVICE (React + Vite)
# Port: 5173
# ============================================

# API Configuration
VITE_API_URL=http://localhost:5000
VITE_AI_SERVICE_URL=http://localhost:8000

# ============================================
# SHARED CONFIGURATION
# ============================================

# Feature Flags
ENABLE_EMAIL_VERIFICATION=true
ENABLE_OAUTH_SSO=false
ENABLE_RESUME_EXTRACTION=true

# Security
SESSION_SECRET=your-session-secret-change-in-production
BCRYPT_ROUNDS=10

# External Integrations
ENABLE_EXTERNAL_INTEGRATIONS=false
WEBHOOK_RETRY_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BACKOFF_MS=1000
